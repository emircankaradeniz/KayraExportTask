{
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "products-route": {
        "ClusterId": "products-cluster",
        "Match": {
          "Path": "/api/products/{**catch-all}"
        }
      },
      "logs-route": {
        "ClusterId": "logs-cluster",
        "Match": {
          "Path": "/api/logs/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-service": {
            "Address": "http://localhost:5101/"
          }
        }
      },
      "products-cluster": {
        "Destinations": {
          "product-service": {
            "Address": "http://localhost:5053/"
          }
        }
      },
      "logs-cluster": {
        "Destinations": {
          "log-service": {
            "Address": "http://localhost:5103/"
          }
        }
      }
    }
  },
  "Serilog": {
    "SeqUrl": "http://localhost:5341"
  },
  "AllowedHosts": "*"
}